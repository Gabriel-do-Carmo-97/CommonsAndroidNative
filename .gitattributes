# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout.
*.kt text diff=kotlin eol=lf
*.kts text diff=kotlin eol=lf
*.java text diff=java eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.pro text eol=lf

# Declare files that will always have CRLF line endings on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must always have LF line endings
gradlew text eol=lf
*.sh text eol=lf

# Denote all binary files that should not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.aar binary
*.so binary
